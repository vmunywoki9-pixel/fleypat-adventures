
/* ==========================================================
   FLEYPAT ADVENTURES
   LIGHT SAFARI BROWN • BURNT ORANGE • WARM CREAM THEME
   ========================================================== */

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap');

/* ==========================================================
   ROOT VARIABLES
   ========================================================== */

:root {
    --lime: #E8752A;
    --lime-dark: #B85B20;

    --cream: #FFF4E8;
    --cream2: #F5E6D6;

    --gold: #D96A25;
    --gold2: #E89552;

    --ink: #6B4935;
    --muted: #897264;

    --green: #A66A42;
    --brown-dark: #8B5635;
    --brown: #A66A42;

    --orange: #E8752A;
    --orange-light: #F09A58;

    --ivory: #FFF4E8;

    --white: #FFFCF8;

    --shadow:
        0 12px 35px rgba(107, 73, 53, 0.10);

    --shadow-hover:
        0 18px 45px rgba(107, 73, 53, 0.16);

    --border:
        1px solid rgba(166, 106, 66, 0.18);
}

/* ==========================================================
   RESET
   ========================================================== */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--ink);
    line-height: 1.7;
    font-size: 15px;
}

img {
    max-width: 100%;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select,
textarea {
    font-family: inherit;
}

button {
    cursor: pointer;
}

::selection {
    background: var(--orange);
    color: white;
}

/* ==========================================================
   TYPOGRAPHY
   ========================================================== */

h1,
h2,
h3,
h4,
h5,
h6 {
    font-family: 'Playfair Display', serif;
    color: var(--brown-dark);
    line-height: 1.25;
    margin-top: 0;
}

h1 {
    font-size: clamp(2.4rem, 5vw, 4.4rem);
}

h2 {
    font-size: clamp(1.8rem, 3.5vw, 3rem);
}

h3 {
    font-size: 1.45rem;
}

p {
    margin-top: 0;
}

.text-muted {
    color: var(--muted);
}

.text-orange {
    color: var(--orange);
}

.text-brown {
    color: var(--brown);
}

/* ==========================================================
   TOP BAR
   ========================================================== */

.topline {
    background: var(--brown-dark);
    color: #FFF4E8;
    padding: 9px 0;
    font-size: 12px;
}

.top-inner {
    max-width: 1200px;
    margin: auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.top-inner a {
    color: #FFF4E8;
    transition: color 0.3s ease;
}

.top-inner a:hover {
    color: var(--orange-light);
}

.top-contact {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

/* ==========================================================
   HEADER
   ========================================================== */

.header {
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 18px rgba(107, 73, 53, 0.06);
    border-bottom: 1px solid rgba(166, 106, 66, 0.12);
}

.nav {
    max-width: 1200px;
    margin: auto;
    padding: 12px 24px;
    min-height: 82px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
}

.brand img {
    width: 65px;
    height: 65px;
    object-fit: contain;
}

.brand-text {
    display: flex;
    flex-direction: column;
}

.brand strong {
    color: var(--brown-dark);
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
}

.brand small {
    color: var(--orange);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.nav nav {
    display: flex;
    align-items: center;
    gap: 21px;
}

.nav nav a {
    color: var(--brown-dark);
    font-size: 13px;
    font-weight: 600;
    transition: color 0.3s ease;
}

.nav nav a:hover,
.nav nav a.active {
    color: var(--orange);
}

.nav-book {
    background: var(--orange);
    color: white !important;
    padding: 11px 19px;
    transition: all 0.3s ease;
}

.nav-book:hover {
    background: var(--orange-dark, #B85B20);
    transform: translateY(-2px);
}

.nav-toggle {
    display: none;
    background: var(--cream2);
    border: none;
    color: var(--brown-dark);
    padding: 10px 14px;
    font-size: 20px;
}

/* ==========================================================
   HERO SECTIONS
   ========================================================== */

.page-hero {
    background:
        linear-gradient(
            90deg,
            rgba(107, 73, 53, 0.82),
            rgba(166, 106, 66, 0.42)
        );
    color: white;
    padding: 100px 24px;
    text-align: center;
    position: relative;
}

.page-hero h1 {
    color: white;
    margin-bottom: 15px;
}

.page-hero p {
    max-width: 760px;
    margin: 0 auto;
    color: #FFF4E8;
    font-size: 17px;
}

.hero-home {
    min-height: 650px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    padding: 70px 24px;
    background:
        linear-gradient(
            rgba(107, 73, 53, 0.45),
            rgba(107, 73, 53, 0.60)
        ),
        url('hero-coast.jpg') center/cover no-repeat;
}

.hero-home h1 {
    color: white;
    max-width: 950px;
    margin: 0 auto 20px;
}

.hero-home p {
    color: #FFF4E8;
    font-size: 18px;
    max-width: 700px;
    margin: 0 auto 30px;
}

/* ==========================================================
   SECTIONS
   ========================================================== */

.section {
    padding: 85px 24px;
    background: var(--cream);
}

.section.alt {
    background: var(--cream2);
}

.container {
    max-width: 1200px;
    margin: auto;
}

.section-head {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px;
}

.section-head h2 {
    margin-bottom: 15px;
}

.section-head p {
    color: var(--muted);
}

/* ==========================================================
   GRID SYSTEM
   ========================================================== */

.grid {
    display: grid;
    gap: 28px;
}

.cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.cols-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

/* ==========================================================
   CARDS
   ========================================================== */

.card {
    background: var(--white);
    border: 1px solid rgba(166, 106, 66, 0.13);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition:
        transform 0.35s ease,
        box-shadow 0.35s ease;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
}

.card .photo {
    width: 100%;
    height: 250px;
    object-fit: cover;
}

.card-content {
    padding: 26px;
}

.card h3 {
    margin-bottom: 12px;
}

.card p {
    color: var(--muted);
}

.mini-tag {
    display: inline-block;
    background: var(--cream2);
    color: var(--brown);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 10px;
    margin-bottom: 14px;
}

.link {
    display: inline-block;
    color: var(--orange);
    font-weight: 700;
    margin-top: 10px;
}

.link:hover {
    color: var(--brown-dark);
}

/* ==========================================================
   BUTTONS
   ========================================================== */

.btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    padding: 14px 25px;
    border: 1px solid transparent;
    background: var(--orange);
    color: white;
    font-weight: 700;
    font-size: 13px;
    text-align: center;
    transition: all 0.3s ease;
}

.btn:hover {
    background: var(--orange-dark, #B85B20);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(184, 91, 32, 0.18);
}

.btn-gold {
    background: var(--brown);
    color: white;
}

.btn-gold:hover {
    background: var(--brown-dark);
}

.btn-outline {
    background: transparent;
    border: 1px solid var(--orange);
    color: var(--orange);
}

.btn-outline:hover {
    background: var(--orange);
    color: white;
}

.btn-white {
    background: white;
    color: var(--brown-dark);
    border-color: white;
}

.btn-white:hover {
    background: var(--cream2);
}

.btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

/* ==========================================================
   BOOKING FINDER
   ========================================================== */

.finder {
    background: var(--white);
    border: 1px solid rgba(166, 106, 66, 0.15);
    box-shadow: var(--shadow);
    padding: 30px;
}

.finder h2 {
    margin-bottom: 25px;
}

.finder-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 15px;
}

.finder-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.finder-field label {
    font-size: 12px;
    color: var(--brown);
    font-weight: 700;
}

.finder-field input,
.finder-field select {
    width: 100%;
    padding: 13px;
    background: var(--cream);
    border: 1px solid #E4D1BE;
    color: var(--ink);
    outline: none;
}

.finder-field input:focus,
.finder-field select:focus {
    border-color: var(--orange);
}

/* ==========================================================
   SPLIT SECTIONS
   ========================================================== */

.split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 50px;
    align-items: center;
}

.split-photo {
    width: 100%;
    min-height: 400px;
    object-fit: cover;
}

.checks {
    list-style: none;
    padding: 0;
    margin: 25px 0;
}

.checks li {
    margin-bottom: 12px;
    color: var(--brown);
}

.checks li::before {
    content: "✓";
    color: var(--orange);
    font-weight: 700;
    margin-right: 12px;
}

/* ==========================================================
   FEATURES
   ========================================================== */

.feature {
    background: var(--brown);
    color: white;
    padding: 35px;
}

.feature h2,
.feature h3 {
    color: white;
}

.feature p {
    color: #FFF4E8;
}

.feature-icon {
    font-size: 35px;
    color: var(--orange-light);
    margin-bottom: 15px;
}

/* ==========================================================
   CTA SECTIONS
   ========================================================== */

.cta {
    background:
        linear-gradient(
            90deg,
            rgba(139, 86, 53, 0.94),
            rgba(166, 106, 66, 0.90)
        );
    color: white;
    padding: 75px 24px;
    text-align: center;
}

.cta h2 {
    color: white;
}

.cta p {
    color: #FFF4E8;
    max-width: 700px;
    margin: 0 auto 25px;
}

/* ==========================================================
   NOTICES
   ========================================================== */

.notice {
    background: #F5E6D6;
    border-left: 4px solid var(--orange);
    padding: 20px 25px;
    color: var(--brown-dark);
}

.notice strong {
    color: var(--orange);
}

/* ==========================================================
   DETAILS / SIDEBAR
   ========================================================== */

.detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 35px;
    align-items: start;
}

.side-panel {
    background: var(--white);
    border: 1px solid rgba(166, 106, 66, 0.15);
    padding: 28px;
    box-shadow: var(--shadow);
}

.side-panel h3 {
    border-bottom: 1px solid #E8D7C8;
    padding-bottom: 15px;
    margin-bottom: 20px;
}

.tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.tag-list span {
    background: var(--cream2);
    color: var(--brown);
    padding: 7px 12px;
    font-size: 12px;
}

/* ==========================================================
   ITINERARY
   ========================================================== */

.itinerary {
    border-left: 2px solid var(--orange);
    padding-left: 25px;
    margin-left: 10px;
}

.itinerary-item {
    position: relative;
    margin-bottom: 35px;
}

.itinerary-item::before {
    content: "";
    width: 12px;
    height: 12px;
    background: var(--orange);
    position: absolute;
    left: -32px;
    top: 6px;
}

.itinerary-item h3 {
    color: var(--brown-dark);
}

.itinerary-item p {
    color: var(--muted);
}

/* ==========================================================
   FORMS
   ========================================================== */

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-field label {
    color: var(--brown-dark);
    font-weight: 700;
    font-size: 13px;
}

.form-field input,
.form-field select,
.form-field textarea {
    width: 100%;
    padding: 14px;
    background: var(--white);
    border: 1px solid #E4D1BE;
    color: var(--ink);
    outline: none;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px rgba(232, 117, 42, 0.08);
}

.form-field textarea {
    min-height: 150px;
    resize: vertical;
}

.form-field.full {
    grid-column: 1 / -1;
}

/* ==========================================================
   FOOTER
   ========================================================== */

.footer {
    background: var(--brown-dark);
    color: #FFF4E8;
    padding: 70px 24px 25px;
}

.footer h3,
.footer h4 {
    color: white;
}

.footer p,
.footer li {
    color: #EBD5C2;
}

.footer a {
    color: #FFF4E8;
    transition: color 0.3s ease;
}

.footer a:hover {
    color: var(--orange-light);
}

.footer-grid {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
}

.footer-brand img {
    width: 85px;
    margin-bottom: 20px;
}

.footer ul {
    list-style: none;
    padding: 0;
}

.footer li {
    margin-bottom: 10px;
}

.foot-bottom {
    max-width: 1200px;
    margin: 50px auto 0;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 244, 232, 0.15);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    color: #EBD5C2;
    font-size: 12px;
}

/* ==========================================================
   FLOATING WHATSAPP
   ========================================================== */

.float-wa {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 999;
    background: #25D366;
    color: white;
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.18);
    transition: transform 0.3s ease;
}

.float-wa:hover {
    transform: scale(1.08);
}

/* ==========================================================
   FAQ
   ========================================================== */

.faq {
    border-bottom: 1px solid #E8D7C8;
    padding: 22px 0;
}

.faq h3 {
    margin-bottom: 10px;
    font-size: 18px;
}

.faq p {
    color: var(--muted);
    margin-bottom: 0;
}

/* ==========================================================
   TABLES
   ========================================================== */

table {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
}

th {
    background: var(--brown);
    color: white;
    text-align: left;
    padding: 15px;
}

td {
    padding: 15px;
    border-bottom: 1px solid #E8D7C8;
    color: var(--ink);
}

tr:nth-child(even) {
    background: var(--cream);
}

/* ==========================================================
   DIVIDERS
   ========================================================== */

hr {
    border: none;
    border-top: 1px solid #E8D7C8;
    margin: 35px 0;
}

/* ==========================================================
   RESPONSIVE DESIGN
   ========================================================== */

@media (max-width: 1000px) {

    .cols-4 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nav nav {
        gap: 13px;
    }

    .nav nav a {
        font-size: 12px;
    }

    .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .finder-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .detail-layout {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 760px) {

    .top-inner {
        justify-content: center;
        text-align: center;
    }

    .top-contact {
        justify-content: center;
    }

    .nav {
        padding: 12px 18px;
    }

    .brand img {
        width: 52px;
        height: 52px;
    }

    .brand strong {
        font-size: 17px;
    }

    .brand small {
        font-size: 9px;
    }

    .nav-toggle {
        display: block;
    }

    .nav nav {
        display: none;
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        background: var(--white);
        padding: 20px;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        border-top: 1px solid #E8D7C8;
        box-shadow: 0 10px 25px rgba(107, 73, 53, 0.10);
    }

    .nav nav.show {
        display: flex;
    }

    .nav nav a {
        padding: 13px 8px;
        border-bottom: 1px solid #F0E3D7;
        font-size: 14px;
    }

    .nav-book {
        text-align: center;
        margin-top: 10px;
    }

    .page-hero {
        padding: 75px 20px;
    }

    .hero-home {
        min-height: 520px;
    }

    .hero-home h1 {
        font-size: 2.5rem;
    }

    .hero-home p {
        font-size: 16px;
    }

    .section {
        padding: 60px 20px;
    }

    .cols-2,
    .cols-3,
    .cols-4,
    .split {
        grid-template-columns: 1fr;
    }

    .grid {
        gap: 22px;
    }

    .split {
        gap: 30px;
    }

    .split-photo {
        min-height: 280px;
    }

    .finder-grid {
        grid-template-columns: 1fr;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .foot-bottom {
        flex-direction: column;
        text-align: center;
    }

    .btn-group {
        flex-direction: column;
    }

    .btn-group .btn {
        width: 100%;
    }

    .card .photo {
        height: 230px;
    }

    .finder {
        padding: 22px;
    }

}

@media (max-width: 480px) {

    .brand {
        gap: 8px;
    }

    .brand img {
        width: 45px;
        height: 45px;
    }

    .brand strong {
        font-size: 15px;
    }

    .brand small {
        letter-spacing: 1px;
    }

    .hero-home h1 {
        font-size: 2rem;
    }

    .page-hero h1 {
        font-size: 2rem;
    }

    .section-head h2 {
        font-size: 1.8rem;
    }

    .card-content {
        padding: 20px;
    }

    .float-wa {
        width: 52px;
        height: 52px;
        right: 15px;
        bottom: 15px;
    }

}

/* ==========================================================
   GLOBAL COLOUR CORRECTIONS FOR LEGACY PAGE ELEMENTS
   ========================================================== */

[style*="#a8d832"],
[style*="#A8D832"],
[style*="#719d1c"],
[style*="#719D1C"] {
    color: var(--orange) !important;
}

/* Legacy green backgrounds */

.bg-green,
.bg-lime,
.green-bg {
    background: var(--brown) !important;
    color: white !important;
}

/* Legacy green text */

.text-green,
.text-lime {
    color: var(--orange) !important;
}

/* Legacy borders */

.border-green,
.border-lime {
    border-color: var(--orange) !important;
}

/* ==========================================================
   END OF FLEYPAT ADVENTURES THEME
   ========================================================== */
